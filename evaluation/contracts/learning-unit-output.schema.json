{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/learning-unit-output.schema.json",
  "title": "Learning Unit AI Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sentences",
    "metadata"
  ],
  "properties": {
    "sentences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "english_text",
          "chinese_meaning"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "english_text": {
            "type": "string",
            "minLength": 1
          },
          "chinese_meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "difficulty",
        "prompt_version"
      ],
      "properties": {
        "style": {
          "const": "AMERICAN_DAILY_SPOKEN"
        },
        "difficulty": {
          "const": "EVERYDAY_INTERMEDIATE"
        },
        "prompt_version": {
          "const": "spoken-en-v7"
        }
      }
    }
  }
}
